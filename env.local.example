# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-KEEP-SECRET

# Gmail SMTP (see README.md "Email setup" section)
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Where admin notification emails (new applications) are sent.
# Defaults to GMAIL_USER if not set.
ADMIN_EMAIL=youraddress@gmail.com

# Password to log into /admin
ADMIN_PASSWORD=choose-a-strong-password

# Tidio live chat / AI (left side). Public key = the part between code.tidio.co/ and .js
# in your Tidio install snippet (Tidio → Settings → Developer → Tidio Chat Code).
NEXT_PUBLIC_TIDIO_KEY=your-tidio-public-key
NEXT_PUBLIC_SITE_URL=https://reflax.org
